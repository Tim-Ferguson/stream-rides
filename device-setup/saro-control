saved_content_package() {
  local target
  if [[ ! -f "$LAST_CONTENT_FILE" ]]; then
    return 1
  fi

  target="$(tr -d '[:space:]' < "$LAST_CONTENT_FILE")"
  case "$target" in
    netflix|firefox|disney|max|hulu|apple-tv)
      echo "$target"
      ;;
    *)
      return 1
      ;;
  esac
}

remember_content_target() {
  local target
  target="$(foreground_content_package || existing_content_package || true)"
  case "$target" in
    netflix|firefox|disney|max|hulu|apple-tv)
      mkdir -p "$STATE_DIR"
      printf '%s\n' "$target" > "$LAST_CONTENT_FILE"
      ;;
  esac
}

remember_explicit_content_target() {
  local target="$1"
  case "$target" in
    hbo|hbo-max)
      target="max"
      ;;
    appletv)
      target="apple-tv"
      ;;
  esac

  case "$target" in
    netflix|firefox|disney|max|hulu|apple-tv)
      mkdir -p "$STATE_DIR"
      printf '%s\n' "$target" > "$LAST_CONTENT_FILE"
      ;;
  esac
}

content_package() {
  foreground_content_package || saved_content_package || existing_content_package
}

wait_for_activity_contains() {
  local needle="$1"
  local attempts="${2:-8}"
  local stacks
  for _ in $(seq 1 "$attempts"); do
    stacks="$(adb_shell am stack list || true)"
    if [[ "$stacks" == *"$needle"* ]]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

wait_for_visible_activity_contains() {
  local needle="$1"
  local attempts="${2:-8}"
  local stacks
  for _ in $(seq 1 "$attempts"); do
    stacks="$(adb_shell am stack list || true)"
    if awk -v needle="$needle" '
      /visible=true/ && /topActivity=ComponentInfo/ {
        top = $0
        sub(/^.*topActivity=ComponentInfo\{/, "", top)
        sub(/\}.*/, "", top)
        if (index(top, needle)) {
          found = 1
        }
      }
      END {
        exit found ? 0 : 1
      }
    ' <<<"$stacks"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

foreground_activity() {
  adb_shell am stack list | awk '
    /^Stack id=/ {
      pinned = 0
    }
    /mWindowingMode=pinned/ {
      pinned = 1
    }
    /visible=true/ && /topActivity=ComponentInfo/ && !pinned {
      sub(/^.*topActivity=ComponentInfo\{/, "")
      sub(/\}.*/, "")
      print
      exit
    }
  '
}

quick_check() {
  require_device
  local overlay foreground
  if is_activity_pinned FreestyleWorkoutActivity; then
    overlay="pinned"
  elif wait_for_visible_activity_contains "FreestyleWorkoutActivity" 1; then
    overlay="running, not pinned"
  else
    overlay="not running"
  fi
  foreground="$(foreground_activity || true)"

  echo "bike ADB: connected"
  echo "Just Ride: $overlay"
  echo "Foreground: ${foreground:-unknown}"
}

dismiss_subscription_banner() {
  require_device
  # Close the bike cancelled-subscription banner when it is visible.
  # These coordinates target the close button at the bike's native 1920x1080
  # resolution. The helper also dismisses the banner when accessibility can
  # identify its exact text.
  adb_shell input tap 1147 31 >/dev/null || true
  echo "Tried to dismiss the bike subscription banner."
}

start_just_ride() {
  require_device
  if wait_for_visible_activity_contains "FreestyleWorkoutActivity" 1; then
    echo "Just Ride is running."
    return 0
  fi

  echo "Opening bike Just Ride..."
  adb_shell am start --windowingMode 1 -a android.intent.action.VIEW -d peloton://activation/justride >/dev/null 2>&1 || true
  if wait_for_visible_activity_contains "FreestyleWorkoutActivity" 8; then
    echo "Just Ride is running."
    return 0
  fi

  # Full-screen and split-screen have different effective tap coordinates.
  # Try the visible Just Ride card first, then the activation landing-page
  # "Try a workout or Just Ride" button, then the card again.
  local tap
  for tap in \
    "735 684" \
    "252 649" \
    "1740 1004" \
    "775 930" \
    "735 684" \
    "252 649"; do
    adb_shell input tap $tap
    if wait_for_visible_activity_contains "FreestyleWorkoutActivity" 4; then
      echo "Just Ride is running."
      return 0
    fi
  done

  echo "I could not confirm Just Ride. Current top activity: $(top_activity || true)" >&2
  return 1
}

close_just_ride_overlay() {
  require_device
  local stack
  stack="$(pinned_stack_for_activity FreestyleWorkoutActivity)"
  if [[ -z "$stack" ]]; then
    reset_display_density
    echo "No Just Ride overlay is pinned."
    return 0
  fi

  adb_shell am stack remove "$stack" >/dev/null || true
  reset_display_density
  sleep 1
  echo "Closed pinned Just Ride overlay."
}

bring_task_front() {
  local task="$1"
  adb_shell am task lock "$task" >/dev/null || true
  adb_shell am task lock stop >/dev/null || true
}

package_installed() {
  local package="$1"
  adb_shell pm path "$package" 2>/dev/null | grep -q '^package:'
}

resolve_launcher_activity() {
  local package="$1"
  local category resolved

  for category in android.intent.category.LAUNCHER android.intent.category.LEANBACK_LAUNCHER; do
    resolved="$(adb_shell cmd package resolve-activity --brief \
      -a android.intent.action.MAIN -c "$category" "$package" 2>/dev/null | \
      tr -d '\r' | \
      awk -v prefix="$package/" 'index($0, prefix) == 1 {component=$0} END {print component}')"
    if [[ -n "$resolved" ]]; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done
  return 1
}

ride_controls_fullscreen() {
  require_device
  remember_content_target
  close_just_ride_overlay >/dev/null || true

  local ride_task
  ride_task="$(task_for_activity FreestyleWorkoutActivity)"
  if [[ -n "$ride_task" ]]; then
    bring_task_front "$ride_task"
  fi

  start_just_ride
  ride_task="$(task_for_activity FreestyleWorkoutActivity)"
  if [[ -n "$ride_task" ]]; then
    bring_task_front "$ride_task"
  fi

  echo "Just Ride controls are full-screen. Use Restore Ride Overlay when done."
}

bring_existing_content_front() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    target="$(content_package || true)"
  fi

  case "$target" in
    netflix)
      adb_shell am start --windowingMode 1 --activity-reorder-to-front -n com.netflix.mediaclient/.ui.launch.NetflixComLaunchActivity >/dev/null 2>&1 || true
      remember_explicit_content_target "netflix"
      echo "Restored Netflix foreground."
      ;;
    firefox|browser)
      adb_shell am start --windowingMode 1 --activity-reorder-to-front -n org.mozilla.firefox/org.mozilla.fenix.HomeActivity >/dev/null 2>&1 || true
      remember_explicit_content_target "firefox"
      echo "Restored Firefox foreground."
      ;;
    disney)
      open_disney_native "Restored Disney+ foreground."
      ;;
    max|hbo|hbo-max)
      open_max_native "Restored Max foreground."
      ;;
    hulu)
      open_hulu_native "Restored Hulu foreground."
      ;;
    apple-tv|appletv)
      open_apple_tv_native "Restored Apple TV foreground."
      ;;
    "")
      echo "No existing media app task found to restore."
      ;;
    *)
      echo "Unknown restore target '$target'. Use netflix, firefox, disney, max, hulu, or apple-tv." >&2
      return 2
      ;;
  esac
}

restore_ride_overlay() {
  require_device
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    remember_content_target
  else
    remember_explicit_content_target "$target"
  fi
  pin_just_ride_overlay
  bring_existing_content_front "$target"
  echo "Ride overlay restored."
}

reset_apps() {
  require_device
  echo "Stopping bike, Firefox, Netflix, Disney+, Max, Hulu, and Apple TV app tasks..."
  reset_display_density
  adb_shell am force-stop com.peloton.activity >/dev/null || true
  adb_shell am force-stop org.mozilla.firefox >/dev/null || true
  adb_shell am force-stop com.netflix.mediaclient >/dev/null || true
  adb_shell am force-stop com.disney.disneyplus >/dev/null || true
  adb_shell am force-stop com.wbd.stream >/dev/null || true
  adb_shell am force-stop com.wbd.hbomax >/dev/null || true
  adb_shell am force-stop com.hulu.plus >/dev/null || true
  adb_shell am force-stop com.apple.atve.androidtv.appletv >/dev/null || true
  sleep 1
  echo "App reset complete."
}

open_browser() {
  require_device
  local url="${1:-https://www.google.com}"
  echo "Opening Firefox at $url..."
  adb_shell am start -a android.intent.action.VIEW -d "$url" >/dev/null
  remember_explicit_content_target "firefox"
}

open_youtube() {
  open_browser "https://www.youtube.com"
}

split_browser() {
  require_device
  local url="${1:-https://www.google.com}"
  enable_window_overrides
  close_just_ride_overlay >/dev/null
  start_just_ride
  open_browser "$url"
  sleep 3

  local ride_task browser_task
  ride_task="$(task_for_package com.peloton.activity)"
  browser_task="$(task_for_package org.mozilla.firefox)"

  if [[ -z "$ride_task" || -z "$browser_task" ]]; then
    echo "Could not identify split-screen tasks. Ride task='$ride_task', browser task='$browser_task'." >&2
    adb_shell am stack list
    exit 1
  fi

  adb_shell am task resizeable "$ride_task" 2 >/dev/null || true
  adb_shell am task resizeable "$browser_task" 2 >/dev/null || true
  adb_shell am stack move-task "$ride_task" 3 true >/dev/null
  sleep 1
  adb_shell am stack move-task "$browser_task" 4 true >/dev/null
  echo "Split-screen is set: Just Ride on the left, Firefox on the right."
}

split_youtube() {
  split_browser "https://www.youtube.com"
}

pin_just_ride_overlay() {
  require_device
  enable_window_overrides
  set_compact_overlay_density
  if is_activity_pinned FreestyleWorkoutActivity; then
    echo "Just Ride is already pinned as an overlay."
    return 0
  fi

  start_just_ride
  sleep 1
  if is_activity_pinned FreestyleWorkoutActivity; then
    echo "Just Ride is already pinned as an overlay."
    return 0
  fi

  local ride_task ride_stack
  ride_task="$(task_for_activity FreestyleWorkoutActivity)"
  ride_stack="$(stack_for_activity FreestyleWorkoutActivity)"

  if [[ -z "$ride_task" || -z "$ride_stack" ]]; then
    echo "Could not identify the Just Ride task for overlay. Ride task='$ride_task', ride stack='$ride_stack'." >&2
    adb_shell am stack list
    exit 1
  fi

  adb_shell am task resizeable "$ride_task" 3 >/dev/null || true
  adb_shell am stack move-top-activity-to-pinned-stack "$ride_stack" 20 20 900 260 >/dev/null
  sleep 2
  echo "Just Ride is pinned as an overlay."
}

overlay_browser() {
  require_device
  local url="${1:-https://www.google.com}"
  pin_just_ride_overlay
  echo "Opening Firefox full-screen at $url..."
