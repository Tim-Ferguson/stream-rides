require_adb() {
  if [[ "$ADB" == */* ]]; then
    if [[ ! -x "$ADB" ]]; then
      echo "ADB not found or not executable at $ADB" >&2
      exit 1
    fi
  elif ! command -v "$ADB" >/dev/null 2>&1; then
    echo "ADB not found on PATH: $ADB" >&2
    exit 1
  fi
}

adb_server_cmd() {
  "$ADB" "$@"
}

adb_cmd() {
  if [[ -n "${ANDROID_SERIAL:-}" ]]; then
    "$ADB" -s "$ANDROID_SERIAL" "$@"
  else
    "$ADB" "$@"
  fi
}

require_device() {
  require_adb
  if [[ "$DEVICE_SELECTED" == "1" ]]; then
    return 0
  fi

  local devices_file selected count state
  devices_file="$(mktemp "${TMPDIR:-/tmp}/saro-adb-devices.XXXXXX")"
  if ! adb_server_cmd devices -l >"$devices_file"; then
    rm -f "$devices_file"
    echo "Could not query ADB devices." >&2
    exit 1
  fi

  if [[ -n "${ANDROID_SERIAL:-}" ]]; then
    selected="$(awk -v serial="$ANDROID_SERIAL" '$1 == serial {print $1 "\t" $2; exit}' "$devices_file")"
    state="${selected#*$'\t'}"
    if [[ -z "$selected" || "$state" != "device" ]]; then
      echo "ANDROID_SERIAL '$ANDROID_SERIAL' is not connected in device state." >&2
      cat "$devices_file" >&2
      rm -f "$devices_file"
      exit 1
    fi
  else
    count="$(awk 'NR > 1 && $2 == "device" {count++} END {print count + 0}' "$devices_file")"
    if [[ "$count" != "1" ]]; then
      echo "Expected exactly one connected ADB device; found $count. Set ANDROID_SERIAL to select one explicitly." >&2
      cat "$devices_file" >&2
      rm -f "$devices_file"
      exit 1
    fi
    ANDROID_SERIAL="$(awk 'NR > 1 && $2 == "device" {print $1; exit}' "$devices_file")"
    export ANDROID_SERIAL
  fi
  if [[ ! "$ANDROID_SERIAL" =~ ^[A-Za-z0-9._:-]+$ ]]; then
    echo "Refusing unsafe ADB serial value: $ANDROID_SERIAL" >&2
    rm -f "$devices_file"
    exit 1
  fi
  rm -f "$devices_file"

  state="$(adb_cmd get-state 2>/dev/null || true)"
  if [[ "$state" != "device" ]]; then
    echo "Selected device '$ANDROID_SERIAL' is not available to ADB." >&2
    adb_server_cmd devices -l >&2 || true
    exit 1
  fi
  DEVICE_SELECTED=1
}

adb_shell() {
  adb_cmd shell "$@"
}

sha256_file() {
  local path="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$path" | awk '{print $1}'
    return
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$path" | awk '{print $1}'
    return
  fi
  echo "A SHA-256 tool is required (shasum or sha256sum)." >&2
  return 1
}

enable_window_overrides() {
  adb_shell settings put global force_resizable_activities 1
  adb_shell settings put global enable_freeform_support 1
}

set_compact_overlay_density() {
  adb_shell wm density 90 >/dev/null || true
  sleep 1
}

reset_display_density() {
  adb_shell wm density reset >/dev/null || true
}

window_overrides_are_reset() {
  local display_size display_density resizable freeform
  display_size="$(adb_shell wm size 2>/dev/null | tr -d '\r')" || return 1
  display_density="$(adb_shell wm density 2>/dev/null | tr -d '\r')" || return 1
  resizable="$(adb_shell settings get global force_resizable_activities 2>/dev/null |
    tr -d '\r')" || return 1
  freeform="$(adb_shell settings get global enable_freeform_support 2>/dev/null |
    tr -d '\r')" || return 1
  [[ "$display_size" == "Physical size: 1920x1080" &&
    "$display_density" == "Physical density: 240" &&
    ( -z "$resizable" || "$resizable" == "null" ) &&
    ( -z "$freeform" || "$freeform" == "null" ) ]]
}

reset_window_overrides() {
  adb_shell wm size reset >/dev/null || return 1
  adb_shell wm density reset >/dev/null || return 1
  adb_shell settings delete global force_resizable_activities >/dev/null || return 1
  adb_shell settings delete global enable_freeform_support >/dev/null || return 1
  if ! window_overrides_are_reset; then
    echo "Android display or legacy window overrides did not reset to the tested state." >&2
    return 1
  fi
}

top_activity() {
  adb_shell am stack list | awk '
    /visible=true/ && /topActivity=ComponentInfo/ {
      sub(/^.*topActivity=ComponentInfo\{/, "")
      sub(/\}.*/, "")
      print
      exit
    }
  '
}

task_for_package() {
  local package="$1"
  adb_shell am stack list | awk -v package="$package" '
    index($0, "taskId=") && index($0, package) {
      task = $0
      sub(/^.*taskId=/, "", task)
      sub(/:.*/, "", task)
      if (fallback == "") {
        fallback = task
      }

      top = $0
      sub(/^.*topActivity=ComponentInfo\{/, "", top)
      sub(/\}.*/, "", top)
      if ($0 ~ /visible=true/ && index(top, package)) {
        visible = task
      }
    }
    END {
      if (visible != "") {
        print visible
      } else if (fallback != "") {
        print fallback
      }
    }
  '
}

task_for_activity() {
  local activity="$1"
  adb_shell am stack list | awk -v activity="$activity" '
    index($0, "taskId=") && index($0, activity) {
      task = $0
      sub(/^.*taskId=/, "", task)
      sub(/:.*/, "", task)
      if (fallback == "") {
        fallback = task
      }

      top = $0
      sub(/^.*topActivity=ComponentInfo\{/, "", top)
      sub(/\}.*/, "", top)
      if ($0 ~ /visible=true/ && index(top, activity)) {
        visible = task
      }
    }
    END {
      if (visible != "") {
        print visible
      } else if (fallback != "") {
        print fallback
      }
    }
  '
}

stack_for_activity() {
  local activity="$1"
  adb_shell am stack list | awk -v activity="$activity" '
    /^Stack id=/ {
      stack = $0
      sub(/^Stack id=/, "", stack)
      sub(/ .*/, "", stack)
    }
    index($0, activity) {
      if (fallback == "") {
        fallback = stack
      }

      top = $0
      sub(/^.*topActivity=ComponentInfo\{/, "", top)
      sub(/\}.*/, "", top)
      if ($0 ~ /visible=true/ && index(top, activity)) {
        visible = stack
      }
    }
    END {
      if (visible != "") {
        print visible
      } else if (fallback != "") {
        print fallback
      }
    }
  '
}

is_activity_pinned() {
  local activity="$1"
  adb_shell am stack list | awk -v activity="$activity" '
    /^Stack id=/ {
      pinned = 0
    }
    /mWindowingMode=pinned/ {
      pinned = 1
    }
    index($0, activity) && pinned {
      found = 1
    }
    END {
      exit found ? 0 : 1
    }
  '
}

pinned_stack_for_activity() {
  local activity="$1"
  adb_shell am stack list | awk -v activity="$activity" '
    /^Stack id=/ {
      stack = $0
      sub(/^Stack id=/, "", stack)
      sub(/ .*/, "", stack)
      pinned = 0
    }
    /mWindowingMode=pinned/ {
      pinned = 1
    }
    index($0, activity) && pinned {
      print stack
      exit
    }
  '
}

